+package org.apache.spark.ml.feature
+
+import org.apache.spark.sql.Row
+import org.apache.spark.sql.execution.benchmark.{MapLookupInvestigation, SqlBasedBenchmark}
+import org.apache.spark.sql.functions._
+import org.apache.spark.sql.types._
+
+/** Measures transform only; fit and input preparation are outside the timed sections. */
+object TargetEncoderMapLookupBenchmark extends SqlBasedBenchmark {
+  override def runBenchmarkSuite(args: Array[String]): Unit = {
+    val harness = MapLookupInvestigation
+    harness.configure(spark, args)
+    val schema = StructType(Seq(StructField("category", DoubleType, nullable = false),
+      StructField("label", DoubleType, nullable = false)))
+    harness.ordered(Seq(1000, 10000)).foreach { size =>
+      val training = (0 until size).flatMap { i =>
+        Seq.fill(5)(Row(i.toDouble, (i % 7).toDouble))
+      }
+      val train = spark.createDataFrame(spark.sparkContext.parallelize(training, 1), schema)
+      val start = System.nanoTime()
+      val model = new TargetEncoder().setInputCols(Array("category"))
+        .setOutputCols(Array("encoded")).setLabelCol("label")
+        .setTargetType("continuous").setSmoothing(0.0).fit(train)
+      harness.save(s"fit-$size.txt", s"elapsedNs=${System.nanoTime() - start}")
+      val input = spark.range(harness.numRows).select((col("id") % size)
+        .cast(DoubleType).as("category")).cache()
+      input.count()
+      val expected = (0 until harness.numRows).map(i => ((i % size) % 7).toDouble).sum
+      try {
+        harness.ordered(harness.selectedModes).foreach { mode =>
+          harness.inMode(mode) {
+            val id = s"target-encoder-$size-${mode.name}"
+            def query() = model.transform(input).agg(sum(col("encoded")))
+            val prepared = query()
+            require(prepared.collect().head.getDouble(0) == expected)
+            harness.capture(id, prepared, size >= mode.threshold, mode.generated)
+            harness.measure(s"$id-repeat", harness.numRows) {
+              require(prepared.collect().head.getDouble(0) == expected)
+            }
+            harness.measure(s"$id-fresh", harness.numRows) {
+              require(query().collect().head.getDouble(0) == expected)
+            }
+          }
+        }
+      } finally {
+        input.unpersist(blocking = true)
+      }
+    }
+  }
+}
